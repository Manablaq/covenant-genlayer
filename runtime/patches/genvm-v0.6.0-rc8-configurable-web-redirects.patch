+#[tokio::test]
+async fn test_unfiltered_client_can_expose_redirect_without_fetching_target() {
+    common::tests::setup();
+
+    let final_server = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let final_addr = final_server.local_addr().unwrap();
+    let location = format!("http://127.0.0.1:{}/final", final_addr.port());
+    let redirect_addr = serve_redirect_owned(location.clone()).await;
+
+    let client = common::create_client_unfiltered_with_redirects(false).unwrap();
+    let url = format!("http://127.0.0.1:{}/start", redirect_addr.port());
+    let metrics = sync::DArc::new(Metrics::default());
+
+    let res = send_request_get_lua_compatible_response_bytes(
+        &metrics,
+        &url,
+        client.get(&url),
+        false,
+        usize::MAX,
+    )
+    .await
+    .expect("expected original redirect response");
+
+    assert_eq!(res.status, 302);
+    assert_eq!(
+        res.headers.get("location").map(|x| x.as_ref()),
+        Some(location.as_bytes())
+    );
+    assert!(
+        tokio::time::timeout(std::time::Duration::from_millis(100), final_server.accept())
+            .await
+            .is_err(),
+        "redirect target must not be fetched"
+    );
+}
+
+#[tokio::test]
+async fn test_unfiltered_client_preserves_default_redirect_following() {
+    common::tests::setup();
+
+    let final_body = b"redirect target reached";
+    let final_addr = serve_once(final_body).await;
+    let location = format!("http://127.0.0.1:{}/final", final_addr.port());
+    let redirect_addr = serve_redirect_owned(location).await;
+
+    let client = common::create_client_unfiltered().unwrap();
+    let url = format!("http://127.0.0.1:{}/start", redirect_addr.port());
+    let metrics = sync::DArc::new(Metrics::default());
+
+    let res = send_request_get_lua_compatible_response_bytes(
+        &metrics,
+        &url,
+        client.get(&url),
+        true,
+        usize::MAX,
+    )
+    .await
+    .expect("expected backward-compatible redirect following");
+
+    assert_eq!(res.status, 200);
+    assert_eq!(res.body, final_body);
+}
